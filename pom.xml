<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>pe.edu.cc531</groupId>
    <artifactId>cc531</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.release>11</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <hadoop.version>3.3.0</hadoop.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-common</artifactId>
            <version>${hadoop.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-mapreduce-client-core</artifactId>
            <version>${hadoop.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>cc531</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>duration-jar</id><phase>package</phase><goals><goal>jar</goal></goals>
                        <configuration><classifier>duration</classifier><archive><manifest>
                            <mainClass>pe.edu.cc531.Main$Duration</mainClass>
                        </manifest></archive></configuration>
                    </execution>
                    <execution>
                        <id>interruption-jar</id><phase>package</phase><goals><goal>jar</goal></goals>
                        <configuration><classifier>interruption</classifier><archive><manifest>
                            <mainClass>pe.edu.cc531.Main$Interruption</mainClass>
                        </manifest></archive></configuration>
                    </execution>
                    <execution>
                        <id>dbscan-jar</id><phase>package</phase><goals><goal>jar</goal></goals>
                        <configuration><classifier>dbscan</classifier><archive><manifest>
                            <mainClass>pe.edu.cc531.Main$DbscanJar</mainClass>
                        </manifest></archive></configuration>
                    </execution>
                    <execution>
                        <id>mlp-class-jar</id><phase>package</phase><goals><goal>jar</goal></goals>
                        <configuration><classifier>mlp-class</classifier><archive><manifest>
                            <mainClass>pe.edu.cc531.Main$MlpClass</mainClass>
                        </manifest></archive></configuration>
                    </execution>
                    <execution>
                        <id>mlp-reg-jar</id><phase>package</phase><goals><goal>jar</goal></goals>
                        <configuration><classifier>mlp-reg</classifier><archive><manifest>
                            <mainClass>pe.edu.cc531.Main$MlpReg</mainClass>
                        </manifest></archive></configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
